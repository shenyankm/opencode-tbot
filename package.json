{
    "name": "opencode-tbot",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "vite build",
        "start": "node dist/index.js",
        "test": "tsx --test tests/**/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "audit": "pnpm audit"
    },
    "dependencies": {
        "@grammyjs/runner": "^2.0.3",
        "@opencode-ai/sdk": "1.2.27",
        "dotenv": "^16.4.5",
        "grammy": "^1.38.0",
        "pino": "^9.3.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^22.7.4",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2",
        "vite": "^8.0.1"
    }
}
