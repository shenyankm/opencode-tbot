{
    "name": "opencode-tbot",
    "version": "0.2.0",
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "description": "Telegram bot plugin for OpenCode",
    "license": "MIT",
    "main": "./dist/index.js",
    "bin": {
        "opencode-tbot": "./bin/opencode-tbot.js"
    },
    "files": [
        "bin",
        "dist",
        "README.md",
        "README.ja.md",
        "README.zh-CN.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli.js",
        "./plugin": "./dist/plugin.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shenyankm/opencode-tbot.git"
    },
    "homepage": "https://github.com/shenyankm/opencode-tbot#readme",
    "bugs": {
        "url": "https://github.com/shenyankm/opencode-tbot/issues"
    },
    "keywords": [
        "opencode",
        "plugin",
        "telegram",
        "bot"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "vite build",
        "prepublishOnly": "pnpm verify:release",
        "test": "tsx --test tests/**/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "audit": "pnpm audit",
        "lint": "node scripts/check-promises.mjs",
        "verify:package": "pnpm build && node scripts/verify-package.mjs",
        "verify:release": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node scripts/verify-package.mjs --release && node tests/verify-host.mjs"
    },
    "dependencies": {
        "@grammyjs/runner": "^2.0.3",
        "@opencode/client": "2.0.29",
        "@opencode/plugin": "2.0.29",
        "grammy": "^1.46.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2",
        "vite": "^8.0.1"
    }
}
