{
    "name": "opencode-tbot",
    "version": "0.1.50",
    "type": "module",
    "description": "Telegram bot plugin for OpenCode",
    "license": "MIT",
    "main": "./dist/index.js",
    "bin": {
        "opencode-tbot": "./bin/opencode-tbot.js"
    },
    "files": [
        "bin",
        "dist",
        "README.md",
        "README.ja.md",
        "README.zh-CN.md",
        "LICENSE"
    ],
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli.js",
        "./plugin": "./dist/plugin.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Shenean/opencode-tbot.git"
    },
    "homepage": "https://github.com/Shenean/opencode-tbot#readme",
    "bugs": {
        "url": "https://github.com/Shenean/opencode-tbot/issues"
    },
    "keywords": [
        "opencode",
        "plugin",
        "telegram",
        "bot"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "vite build",
        "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test",
        "test": "tsx --test tests/**/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "audit": "pnpm audit"
    },
    "dependencies": {
        "@grammyjs/runner": "^2.0.3",
        "@opencode-ai/plugin": "1.2.27",
        "@opencode-ai/sdk": "1.2.27",
        "grammy": "^1.38.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^22.7.4",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2",
        "vite": "^8.0.1"
    }
}